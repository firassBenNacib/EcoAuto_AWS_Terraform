compatibility_mode              = "workspace"
use_default_vpc                 = false
allow_default_vpc_outside_prod  = false
enable_observability_addons     = false # Additional cost: enables VPC Flow Logs + CloudFront access logs
enable_vpc_flow_logs            = false
lockdown_default_security_group = true
enable_snapshot_cleanup         = true
snapshot_retention_days         = 14
snapshot_min_keep_count         = 3

workspace_domain                  = "example.com"
workspace_backend_subdomain       = "api"
workspace_bootstrap_origin_domain = "placeholder-backend.example.com"
append_workspace_to_bucket_name   = true

aws_region = "eu-west-1"
vpc_cidr   = "10.30.0.0/16"

availability_zones      = ["eu-west-1a", "eu-west-1b"]
public_app_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]
private_db_subnet_cidrs = ["10.30.11.0/24", "10.30.12.0/24"]

bucket_name                                         = "front-yourapp"
enable_s3_kms_encryption                            = false
enable_s3_lifecycle                                 = false
s3_lifecycle_noncurrent_expiration_days             = 30
s3_lifecycle_abort_incomplete_multipart_upload_days = 7

ec2_ami_id       = "ami-xxxxxxxxxxxxxxxxx"
instance_type    = "t4g.nano"
ec2_key_name     = "your-prod-key-name"
user_data_script = "no_encryption_almalinux2023.sh"

launch_template_prefix = "yourapp-template-"
ec2_instance_name      = "YourAppBackend"
asg_name               = "yourapp-asg"

acm_cert_backend  = "arn:aws:acm:us-east-1:123456789012:certificate/backend-cert-id"
acm_cert_frontend = "arn:aws:acm:us-east-1:123456789012:certificate/frontend-cert-id"

frontend_domain = "example.com"
backend_domain  = "api.example.com"

backend_port                                       = 8088
backend_origin_protocol_policy                     = "http-only"
allow_backend_https_origin_with_dynamic_public_dns = false
backend_bootstrap_origin_domain                    = "placeholder-backend.example.com"
backend_cache_policy_id                            = "4135ea2d-6df8-44a3-9df3-4b5a84be39ad"
backend_origin_request_policy_id                   = "216adef6-5c7f-47e4-b989-5492eafa07d3"
backend_geo_locations                              = ["US", "FR", "DE", "TN"]
backend_price_class                                = "PriceClass_100"
frontend_price_class                               = "PriceClass_100"
frontend_response_headers_policy_id                = "eaab4381-ed33-4a86-88ca-d9558dc6cd63"

enable_origin_auth_header      = true
origin_auth_header_name        = "X-Origin-Verify"
origin_auth_header_value       = "CHANGE_ME_WITH_LONG_RANDOM_SECRET"
enable_origin_health_probe     = true
origin_health_path             = "/health"
origin_health_interval_minutes = 5
origin_health_timeout_seconds  = 2
enable_update_infra_alarm      = true
enable_cloudfront_access_logs  = false
enable_cloudfront_logs_lifecycle = true
cloudfront_logs_expiration_days  = 90

rds_identifier              = "yourappdb"
rds_db_name                 = "YourApp"
rds_instance_class          = "db.t4g.micro"
kms_key_id                  = "arn:aws:kms:eu-west-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
rds_backup_retention_period = 7
rds_deletion_protection     = true
rds_skip_final_snapshot     = false
enable_rds_iam_auth         = true

route53_zone_id = "Z1234567890EXAMPLE"

start_schedule_expression                     = "cron(0 5 * * ? *)"
stop_schedule_expression                      = "cron(0 23 * * ? *)"
snapshot_cleanup_schedule_expression          = "cron(0 22 * * ? *)"
eventbridge_lambda_retry_attempts             = 6
eventbridge_lambda_max_event_age_seconds      = 3600
eventbridge_stop_lambda_retry_attempts        = 24
eventbridge_stop_lambda_max_event_age_seconds = 21600

rds_username = "db_admin"
rds_password = "CHANGE_ME"

enable_lambda_xray_tracing                           = true
enable_lambda_async_failure_queue                    = true
lambda_async_failure_queue_message_retention_seconds = 1209600
lambda_async_maximum_retry_attempts                  = 2
lambda_async_max_event_age_seconds                   = 3600
stop_snapshot_wait_seconds                           = 240
stop_snapshot_poll_interval_seconds                  = 20
cloudfront_api_max_attempts                          = 5
cloudfront_api_base_backoff_seconds                  = 1
cloudfront_api_max_backoff_seconds                   = 16
